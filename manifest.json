{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "8.1.1",

  "description": "__MSG_extensionDescription__",

  "icons": {
    "24": "icons/undoclosetab.png",
    "32": "icons/undoclosetab.png",
    "50": "icons/undoclosetab.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": "icons/undoclosetab.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "commands": {
    "_execute_action": {
    }
  },

  "permissions": [
    "contextMenus",
    "tabs",
    "sessions",
    "storage"
  ],

  "default_locale": "en"
}
